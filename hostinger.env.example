# Robokalam on Hostinger: every setting, ready to paste into
#   hPanel → Websites → robokalam.com → Node.js → Environment variables
# Fill the values marked CHANGE_ME. Lines starting with # are notes, not settings.
# Full steps: docs/HOSTINGER.md.  Make the two secrets with:  npm run secrets
#
# After changing anything marked (rebuild), click Redeploy so the site is built again.

# ======================= 1. Needed to go live =======================

# --- Site ---
NODE_ENV=production
# (rebuild) Use https://new.robokalam.com while testing; switch to https://robokalam.com to go live.
NEXT_PUBLIC_SITE_URL=https://robokalam.com

# --- Secrets (npm run secrets prints fresh ones) ---
SESSION_SECRET=CHANGE_ME_64_HEX_CHARACTERS
CRON_SECRET=CHANGE_ME_32_HEX_CHARACTERS

# --- Database: hPanel → Databases → MySQL Databases ---
# Hostinger prefixes names, e.g. u123456789_robokalam. Host is localhost on the same account.
# If the password has @ : / # ? %, URL-encode it (@ becomes %40) or pick one without them.
DATABASE_URL=mysql://u123456789_rkuser:CHANGE_ME@localhost:3306/u123456789_robokalam
DATABASE_SSL=

# --- Email: hPanel → Emails → create the mailbox info@robokalam.com (or no-reply@) ---
# Sign-in codes are sent by email, so this is required.
EMAIL_TRANSPORT=smtp
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@robokalam.com
SMTP_PASS=CHANGE_ME_MAILBOX_PASSWORD
MAIL_FROM=Robokalam <info@robokalam.com>
MAIL_REPLY_TO=info@robokalam.com
# Team inboxes (can all be the same mailbox)
OPS_EMAIL=info@robokalam.com
SCHOOLS_EMAIL=info@robokalam.com
SAFEGUARDING_EMAIL=info@robokalam.com
SAFEGUARDING_RESPONSE_HOURS=24

# --- Payments: Razorpay Dashboard → Account & Settings → API Keys (Live mode) ---
RAZORPAY_KEY_ID=rzp_live_CHANGE_ME
RAZORPAY_KEY_SECRET=CHANGE_ME
# Razorpay → Webhooks → https://robokalam.com/api/webhooks/razorpay (events: payment.captured, order.paid)
RAZORPAY_WEBHOOK_SECRET=CHANGE_ME

# --- GST invoices (confirm with your CA) ---
GST_RATE_PERCENT=18
SUPPLIER_GSTIN=CHANGE_ME_15_CHARACTERS
SUPPLIER_ADDRESS=Robokalam Technologies Private Limited, CHANGE_ME registered address, Hyderabad, Telangana, India
SAC_CODE=999293

# --- Backups: after the first restore check passes (npm run backup:verify) ---
BACKUP_VERIFIED_AT=

# ======================= 2. Already decided (leave as they are) =======================
# Company name, legal pages and refund policy were approved on 4 Nov 2026.
# Set LEGAL_PAGES_APPROVED=0 or REFUND_POLICY_APPROVED=0 only to reopen them.
LEGAL_NAME=Robokalam Technologies Private Limited
PILOT_CITY=Hyderabad
PILOT_MAX_LIVE=25
HARDWARE_SLA_HOURS=72
LEAD_RATE_LIMIT=8

# ======================= 3. Later, when you're ready =======================
# Mobile sign-in by SMS (the "Use mobile number instead" link appears once set):
OTP_PROVIDER=
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# (rebuild) Named people, published on the privacy and child-safety pages and in the footer:
SAFEGUARDING_LEAD_NAME=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
# Lead forwarding to a CRM (leads are always saved in the database):
CRM_WEBHOOK_LEARNER=
CRM_WEBHOOK_SCHOOL=
CRM_WEBHOOK_EDUCATOR=
CRM_WEBHOOK_TOKEN=
# Integrations, once each team confirms its API:
AADHYA_API_URL=
AADHYA_API_KEY=
SCHOOL21C_API_URL=
SCHOOL21C_API_KEY=
VALIDATE_API_URL=
VALIDATE_API_KEY=
# Kalamite's Own Course share, from the approved Kalamite terms (the brief suggests 70):
OWN_COURSE_FELLOW_SHARE_PCT=
# AI review of Kalamite course drafts (Anthropic API key):
ANTHROPIC_API_KEY=

# ======================= Never set these on the live site =======================
# ALLOW_TEST_PROVIDERS, PAYMENT_PROVIDER=mock, OTP_PROVIDER=test, INSECURE_COOKIES,
# NEXT_PUBLIC_REVIEW_MODE. The start-up checks refuse to start robokalam.com with them.
