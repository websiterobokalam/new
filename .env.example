# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://robokalam.com
# 1 = show dashed "awaiting content" panels for review builds. Leave unset in production.
NEXT_PUBLIC_REVIEW_MODE=
# CRM routing by door. Leads POST here as JSON. Without these, production refuses leads (no silent loss).
CRM_WEBHOOK_LEARNER=
CRM_WEBHOOK_SCHOOL=
CRM_WEBHOOK_EDUCATOR=
CRM_WEBHOOK_TOKEN=
# Development / test only: store leads in .data/leads.ndjson
LEADS_LOCAL_FILE=
LEAD_RATE_LIMIT=8
# Phase 2: MSG91 or equivalent
OTP_PROVIDER=

# ---- Phase 2 ----
# Postgres: the app connects as a NON-owner role so row-level security applies.
DATABASE_URL=postgres://rk_app:CHANGE_ME@localhost:5432/robokalam
# Migrations run as the owner role.
DATABASE_OWNER_URL=postgres://rk_owner:CHANGE_ME@localhost:5432/robokalam
# Managed Postgres (Supabase etc.): the provider's CA certificate (PEM). With it, every
# connection is encrypted AND verified. Paste multi-line, or one line with \n. See docs/DATABASE.md.
DATABASE_CA_CERT=
# 32+ random bytes. Signs OTP hashes and IP hashes.
SESSION_SECRET=
# OTP: msg91 in production (DLT-registered template). console = dev only.
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Razorpay (UPI, cards). Webhook URL: /api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST invoice details (to confirm with your CA)
GST_RATE_PERCENT=18
SUPPLIER_GSTIN=
SUPPLIER_ADDRESS=
SAC_CODE=
# Set to 1 only after the refund policy is approved; until then refunds go to human review.
REFUND_POLICY_APPROVED=
# Safeguarding: response target in hours, and an alert webhook for the Lead.
SAFEGUARDING_RESPONSE_HOURS=24
SAFEGUARDING_WEBHOOK=
# Tests and review builds ONLY: fixed OTP 123456 and mock payments. Never in production.
ALLOW_TEST_PROVIDERS=
PAYMENT_PROVIDER=

# ---- Phase 3: Kalam Fellows pilot ----
# One city first, about 25 live Fellows. Applications elsewhere join the waitlist.
PILOT_CITY=Hyderabad
PILOT_MAX_LIVE=25
