# Public site URL (canonical links, sitemap, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://robokalam.com
# 1 = show dashed "awaiting content" panels for review builds. Leave unset in production.
NEXT_PUBLIC_REVIEW_MODE=
# CRM routing by door. Leads POST here as JSON. Without these, production refuses leads (no silent loss).
CRM_WEBHOOK_LEARNER=
CRM_WEBHOOK_SCHOOL=
CRM_WEBHOOK_EDUCATOR=
CRM_WEBHOOK_TOKEN=
# Leads are stored in the database. Optionally also forward them to a CRM:
LEAD_RATE_LIMIT=8
# Phase 2: MSG91 or equivalent
OTP_PROVIDER=

# ---- Phase 2 ----
# MySQL 8.0.16+ or MariaDB 10.6+ (Hostinger hPanel → Databases). See docs/DATABASE.md.
# Format: mysql://USER:PASSWORD@HOST:3306/DATABASE  (URL-encode special characters in the password)
DATABASE_URL=mysql://u123456789_robokalam:CHANGE_ME@localhost:3306/u123456789_robokalam
# Only if the database is on another server and requires TLS:
DATABASE_SSL=
DATABASE_CA_CERT=
# 32+ random bytes. Signs OTP hashes and IP hashes.
SESSION_SECRET=
# OTP: msg91 in production (DLT-registered template). console = dev only.
OTP_PROVIDER=msg91
MSG91_AUTH_KEY=
MSG91_TEMPLATE_ID=
# Razorpay (UPI, cards). Webhook URL: /api/webhooks/razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# GST invoice details (to confirm with your CA)
GST_RATE_PERCENT=18
SUPPLIER_GSTIN=
SUPPLIER_ADDRESS=
SAC_CODE=
# Refund policy approved (4 Nov 2026): refunds follow the published rules automatically. Set to 0 to send every request to a person.
REFUND_POLICY_APPROVED=
# Safeguarding: response target in hours, and an alert webhook for the Lead.
SAFEGUARDING_RESPONSE_HOURS=24
SAFEGUARDING_WEBHOOK=
# Tests and review builds ONLY: fixed OTP 123456 and mock payments. Never in production.
ALLOW_TEST_PROVIDERS=
PAYMENT_PROVIDER=

# ---- Phase 3: Kalam Fellows pilot ----
# One city first, about 25 live Fellows. Applications elsewhere join the waitlist.
PILOT_CITY=Hyderabad
PILOT_MAX_LIVE=25

# ---- Phase 4: schools ----
# Default hardware replacement window (hours) for new partner schools. Each
# school's own value is set by ops from its signed contract.
HARDWARE_SLA_HOURS=72
# Integrations (read live; Robokalam stores counts only). Leave blank until
# each team confirms its API. Blank = the portal says "not connected yet".
AADHYA_API_URL=
AADHYA_API_KEY=
SCHOOL21C_API_URL=
SCHOOL21C_API_KEY=
VALIDATE_API_URL=
VALIDATE_API_KEY=

# ---- Phase 5: open marketplace ----
# Fellow's share of a Fellow's Own Course fee, in percent, from your approved
# Fellow terms (the brief suggests 70). Leave blank until approved: courses can
# be reviewed but not published.
OWN_COURSE_FELLOW_SHARE_PCT=
# AI review of Fellow course drafts (Claude). Leave blank to switch it off;
# rule checks and human review still run. The model defaults to claude-opus-5-5.
ANTHROPIC_API_KEY=
QUALITY_AI_MODEL=

# ---- Email automation ----
# smtp = send for real (Hostinger mail: SMTP_HOST=smtp.hostinger.com, SMTP_PORT=465,
# SMTP_USER=your mailbox, SMTP_PASS=its password). Blank = emails wait in the queue.
EMAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
MAIL_FROM=Robokalam <hello@robokalam.com>
MAIL_REPLY_TO=
# Team inboxes for new leads, safety alerts and reviews. Blank = no team email.
OPS_EMAIL=
SAFEGUARDING_EMAIL=
SCHOOLS_EMAIL=
# Optional: a Hostinger cron job can call /api/cron/email?key=CRON_SECRET every 5 minutes.
# The site also sends on its own every 30 seconds while it runs.
CRON_SECRET=

# ---- Phase 6: launch readiness ----
# `npm start` runs scripts/preflight.mjs first. On the live address
# (NEXT_PUBLIC_SITE_URL=https://robokalam.com, production, review mode off) the
# server will NOT start while a launch blocker remains. Ops → Launch readiness
# lists each one with its fix. LAUNCH_PREFLIGHT=warn is an emergency override.
LAUNCH_PREFLIGHT=
# Registered company name. Default: Robokalam Technologies Private Limited (confirmed 4 Nov 2026).
LEGAL_NAME=
# Legal pages and refund policy are approved (4 Nov 2026). Set to 0 to put them back into draft.
LEGAL_PAGES_APPROVED=
# Optional named people. Until set, published as roles of Robokalam Technologies at info@robokalam.com.
SAFEGUARDING_LEAD_NAME=
GRIEVANCE_OFFICER_NAME=
GRIEVANCE_OFFICER_EMAIL=
# Date the last backup restore check passed (node scripts/backup-verify.mjs prints it).
BACKUP_VERIFIED_AT=
# Empty scratch database used only by the backup check. Never the live database.
BACKUP_VERIFY_URL=
